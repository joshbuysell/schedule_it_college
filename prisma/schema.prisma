generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

model Group {
  id         Int        @id @default(autoincrement())
  name       String     @unique
  course     Int
  specialty  String
  lessons    Lesson[]
  practices  Practice[]
  updatedAt  DateTime   @updatedAt
}

model Teacher {
  id         Int      @id @default(autoincrement())
  shortName  String   @unique
  fullName   String?
  commission String?
  degree     String?
  lessons    Lesson[]
}

model Subject {
  id      Int      @id @default(autoincrement())
  name    String   @unique
  lessons Lesson[]
}

model Room {
  id      Int      @id @default(autoincrement())
  name    String   @unique
  shared  Boolean  @default(false)
  lessons Lesson[]
}

model Lesson {
  id        Int      @id @default(autoincrement())
  groupId   Int
  group     Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  day       Int
  pair      Int
  week      String   @default("all")
  subgroup  Int      @default(0)
  subjectId Int
  subject   Subject  @relation(fields: [subjectId], references: [id])
  teacherId Int?
  teacher   Teacher? @relation(fields: [teacherId], references: [id], onDelete: SetNull)
  roomId    Int?
  room      Room?    @relation(fields: [roomId], references: [id], onDelete: SetNull)
  updatedAt DateTime @updatedAt

  @@index([groupId, day, pair])
  @@index([teacherId])
  @@index([roomId])
}

model Practice {
  id       Int    @id @default(autoincrement())
  groupId  Int
  group    Group  @relation(fields: [groupId], references: [id], onDelete: Cascade)
  title    String
  dates    String
  teachers String
}

model Bell {
  pair  Int    @id
  start String
  end   String
}

model Setting {
  key   String @id
  value String
}

model User {
  id           Int    @id @default(autoincrement())
  email        String @unique
  name         String
  passwordHash String
  role         String @default("editor")
}
