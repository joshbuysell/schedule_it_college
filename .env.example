DATABASE_URL="postgresql://postgres@localhost:5432/schedule"
DATABASE_URL_UNPOOLED="postgresql://postgres@localhost:5432/schedule"
# Секрет для підпису сесій адмінки (згенеруйте: openssl rand -hex 32)
AUTH_SECRET="change-me"
# Обліковий запис навчальної частини, що створюється командою npm run db:seed
ADMIN_EMAIL="admin@itcollege.lviv.ua"
ADMIN_PASSWORD="schedule2026"
# Публічна адреса системи (для коду вставки на сторінці /integration), напр. https://schedule.itcollege.lviv.ua
PUBLIC_URL=""

# Telegram-бот (необовʼязково): токен від @BotFather і будь-який випадковий рядок
TELEGRAM_BOT_TOKEN=""
TELEGRAM_WEBHOOK_SECRET=""
# Захищає щоранкову розсилку (/api/digest); Vercel Cron передає його автоматично
CRON_SECRET=""

# Push-сповіщення працюють без налаштувань: ключі створюються автоматично й зберігаються в базі.
# За бажання їх можна задати явно (npx web-push generate-vapid-keys)
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
